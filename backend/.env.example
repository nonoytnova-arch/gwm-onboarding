DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gwm_onboarding
JWT_SECRET=change_this_to_a_long_random_string
PORT=5000

# Encryption key for sensitive fields (bank account number, ID numbers).
# Must be exactly 32 bytes. Generate one with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=change_this_to_a_64_character_hex_string_32_bytes

# --- Third-party integrations: NOT wired to a real provider yet ---
# Until these are filled in and utils/notify.js / utils/smsProvider.js are
# updated to call the real provider's API, OTPs and confirmations are only
# logged to the server console (see utils/notify.js). Never shown to the
# end user as "sent" unless a real provider is actually configured.
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
GST_LOOKUP_API_KEY=
BANK_VERIFICATION_API_KEY=
